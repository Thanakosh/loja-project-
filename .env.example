# .env.example — Copie este arquivo para .env e preencha com seus valores reais
# O arquivo .env NUNCA deve ser commitado no repositório

# ── Banco de Dados ──────────────────────────────────────────────────────────
# Exemplo didático: NÃO use esta URL literal em produção (placeholder).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/loja_db
SQLALCHEMY_ECHO=False

# ── Segurança ────────────────────────────────────────────────────────────────
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_SEGURA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── IA / LLM (reservado para versão futura) ──────────────────────────────────
# Ollama, OpenAI e Gemini foram removidos desta versão.
# Serão reintroduzidos quando OCR/LLM for reimplementado com arquitetura de filas.
# GEMINI_API_KEY=
# OLLAMA_URL=http://localhost:11434

# ── WhatsApp (opcional) ──────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_GATEWAY_URL=http://localhost:3100
WHATSAPP_GATEWAY_INTERNAL_TOKEN=
WHATSAPP_ACCOUNT_KEY=default
WHATSAPP_DEFAULT_COUNTRY=55

# ── Configurações da API ─────────────────────────────────────────────────────
# Valores aceitos: development, test, staging, production
ENVIRONMENT=development
DEBUG=False

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# Em produção, substitua pelo domínio real. Nunca use ["*"] com credenciais.
CORS_ORIGINS=["http://localhost:3000"]

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_OCR=10/hour
RATE_LIMIT_AI=60/hour
RATE_LIMIT_DEFAULT=100/minute

# ── Redis / Fila Assíncrona OCR (ARQ) ────────────────────────────────────────
# URL de conexão ao Redis. Em produção, use host/porta do serviço real.
REDIS_URL=redis://localhost:6379/0
# Tempo de vida das tarefas OCR no Redis (em horas). Padrão: 24h.
OCR_TASK_TTL_HOURS=24
# Número máximo de tentativas automáticas em caso de falha. Padrão: 3.
OCR_MAX_RETRIES=3
# Segundos de espera entre cada retry. Padrão: 30s.
OCR_RETRY_DELAY_SECONDS=30

# ── Docker / PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=loja_user
POSTGRES_PASSWORD=loja_pass
POSTGRES_DB=loja_db

# ── Observações de segurança ──
# [ ] JWT_SECRET deve ser gerado aleatoriamente
# [ ] DATABASE_URL não pode conter credenciais de exemplo em produção
# [ ] CORS_ORIGINS não pode ser ["*"] em staging/production
# [ ] DEBUG=False é obrigatório em produção
