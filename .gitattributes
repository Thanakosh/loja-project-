# Normaliza line endings para LF em todos os arquivos de texto
* text=auto eol=lf

# Arquivos que devem sempre ser LF
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.env text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binários — sem conversão
*.db binary
*.bundle binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.whl binary
